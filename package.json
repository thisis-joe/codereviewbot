{
  "name": "codereviewbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:integration": "npm run build && node --test --test-concurrency=1 test/integration/*.test.mjs",
    "start": "node dist/server.js",
    "runner": "node dist/runner-server.js",
    "demo": "npm run build && node scripts/demo.mjs",
    "migrate": "node dist/migrate.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "pg": "8.23.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
