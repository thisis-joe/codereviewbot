[
  {
    "id": "crbDispatch",
    "name": "hey — durable dispatch",
    "active": false,
    "nodes": [
      {
        "id": "Every 10 seconds",
        "name": "Every 10 seconds",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [
          200,
          100
        ],
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "seconds",
                "secondsInterval": 10
              }
            ]
          }
        }
      },
      {
        "id": "Webhook",
        "name": "Webhook",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "webhookId": "crb-review-wakeup",
        "position": [
          200,
          300
        ],
        "parameters": {
          "httpMethod": "POST",
          "path": "review-wakeup",
          "authentication": "headerAuth",
          "responseMode": "onReceived",
          "options": {
            "responseCode": {
              "values": {
                "responseCode": 202
              }
            }
          }
        },
        "credentials": {
          "httpHeaderAuth": {
            "id": "crbInternalAuth",
            "name": "hey Internal"
          }
        }
      },
      {
        "id": "Dispatch",
        "name": "Dispatch",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          480,
          200
        ],
        "parameters": {
          "method": "POST",
          "url": "http://controller:8092/internal/tick",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "options": {
            "timeout": 10000
          }
        },
        "credentials": {
          "httpHeaderAuth": {
            "id": "crbInternalAuth",
            "name": "hey Internal"
          }
        },
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 1000
      }
    ],
    "connections": {
      "Every 10 seconds": {
        "main": [
          [
            {
              "node": "Dispatch",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Webhook": {
        "main": [
          [
            {
              "node": "Dispatch",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    },
    "settings": {
      "executionOrder": "v1",
      "timezone": "Asia/Seoul"
    }
  },
  {
    "id": "crbRecovery",
    "name": "hey — recovery",
    "active": false,
    "nodes": [
      {
        "id": "Every minute",
        "name": "Every minute",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [
          200,
          100
        ],
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "minutes",
                "minutesInterval": 1
              }
            ]
          }
        }
      },
      {
        "id": "Recover",
        "name": "Recover",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          480,
          200
        ],
        "parameters": {
          "method": "POST",
          "url": "http://controller:8092/internal/recover",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "options": {
            "timeout": 10000
          }
        },
        "credentials": {
          "httpHeaderAuth": {
            "id": "crbInternalAuth",
            "name": "hey Internal"
          }
        },
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 1000
      }
    ],
    "connections": {
      "Every minute": {
        "main": [
          [
            {
              "node": "Recover",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    },
    "settings": {
      "executionOrder": "v1",
      "timezone": "Asia/Seoul"
    }
  }
]
