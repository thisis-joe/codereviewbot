# Generated private values: node scripts/setup.mjs (never commit .env)
POSTGRES_PASSWORD=
BOT_DB_PASSWORD=
N8N_DB_PASSWORD=
INTERNAL_TOKEN=
RUNNER_TOKEN=
N8N_ENCRYPTION_KEY=
GITHUB_WEBHOOK_SECRET=
# GitLab signing secret from GitLab webhook settings (whsec_...), not an invented value.
GITLAB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITLAB_TOKEN=
# Existing Mattermost incoming webhook URL. Treat the full URL as a secret.
MATTERMOST_WEBHOOK_URL=
# Review engine: codex or claude. Each uses an account login or an API key (+ optional proxy base URL, e.g. GMS).
MODEL_PROVIDER=codex
CODEX_MODEL=
CODEX_API_KEY=
# OpenAI-compatible base URL including /v1. Requires CODEX_API_KEY.
CODEX_BASE_URL=
CLAUDE_MODEL=
# Account login: output of `claude setup-token` (Claude subscription).
CLAUDE_CODE_OAUTH_TOKEN=
# API key login. ANTHROPIC_AUTH_TOKEN is sent as a Bearer token for proxies that expect one.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
# Anthropic-compatible base URL (without /v1).
ANTHROPIC_BASE_URL=
# Switching to an API gateway such as SSAFY GMS: clear CLAUDE_CODE_OAUTH_TOKEN, then use the gateway's
# documented base URL and issued key. Anthropic-format gateway: MODEL_PROVIDER=claude, ANTHROPIC_BASE_URL,
# ANTHROPIC_API_KEY (or ANTHROPIC_AUTH_TOKEN). OpenAI Responses-format gateway: MODEL_PROVIDER=codex,
# CODEX_BASE_URL, CODEX_API_KEY. Set CLAUDE_MODEL/CODEX_MODEL to a model name the gateway offers.
# Cloudflare dashboard tunnel token (compose.override.yaml).
CLOUDFLARE_TUNNEL_TOKEN=
# Container timezone (IANA name) for logs, git and Postgres session time.
TZ=Asia/Seoul
CONTROLLER_PORT=18092
N8N_PORT=5688
